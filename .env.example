# Generate credentials using the README command before starting the service.
RELIQUARY_SANDBOX_TOKENS={}
RELIQUARY_SANDBOX_PUBLIC_BASE_URL=http://127.0.0.1:8000
RELIQUARY_SANDBOX_DEFAULT_IMAGE=reliquary-sandbox-guest:0.1.0
RELIQUARY_SANDBOX_ALLOWED_IMAGES=["reliquary-sandbox-guest:0.1.0"]
RELIQUARY_SANDBOX_BIND_ADDRESS=127.0.0.1

# Signed episode hosts only (docs/deployment.md, "Episode hosts"). Compose passes only
# the variables its `environment:` block lists: add the ones you set.
# RELIQUARY_SANDBOX_EPISODES_ENABLED=true
# RELIQUARY_SANDBOX_MACHINE_ID=machine-1
# RELIQUARY_SANDBOX_MACHINE_KEY_ID=machine-1-2026-10
# RELIQUARY_SANDBOX_MACHINE_KEY_FILE=/keys/machine.pem
# RELIQUARY_SANDBOX_VALIDATOR_PUBLIC_KEYS={"validator-2026-10":"<base64 Ed25519 public key>"}
# RELIQUARY_SANDBOX_EPISODE_IMAGES=["registry.example/task@sha256:<digest>"]
# RELIQUARY_SANDBOX_EPISODE_ENVS={"reliquary-swe":"reliquary_swe.sandbox:sandbox_task"}
# RELIQUARY_SANDBOX_EPISODE_HELPER_BUSYBOX=/opt/reliquary/busybox
# RELIQUARY_SANDBOX_EPISODE_HELPER_BUSYBOX_SHA256=<sha256sum of that file>
# RELIQUARY_SANDBOX_EPISODE_CAPACITY=8
# RELIQUARY_SANDBOX_HEARTBEAT_URL=https://validator.example/sandbox/heartbeat
